# Copy to .env.local and fill in. .env.local is gitignored.

# ---------------------------------------------------------------------------
# Anthropic API  --  PERSONAL organisation, not Fabric's.
# Console payment methods are org-level, and this app sends photos of your food
# and stores your bodyweight; that traffic must not sit in a company-owned org.
# Sign up at console.anthropic.com with a personal email, add a personal card,
# and create the key there. Name it nutrition-app-personal.
# Your Claude subscription does NOT cover API usage - this is separate metered billing.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Supabase  --  from Project Settings > API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service-role key. Server-side only, never prefixed NEXT_PUBLIC_.
# The estimate route uses it to write macros back to an entry row after the
# Claude call returns, which can outlive the user's browser session.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---------------------------------------------------------------------------
# Web Push  --  Shabbat prep + havdalah reconciliation notifications (plan 10.2).
# Generate once with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key is safe to expose (it's how the browser addresses YOUR server, not a
# secret); the private key signs outgoing pushes and must never reach the client.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Any mailto: address - required by the push spec, used only if a push provider needs
# to reach you about abuse. Your own email is fine.
VAPID_SUBJECT=mailto:you@example.com

# Bearer token Vercel Cron sends automatically when this env var is set on the project -
# stops anyone who finds /api/cron/shabbat from triggering it. Any random string.
CRON_SECRET=
